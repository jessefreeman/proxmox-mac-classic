#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1091
source /usr/local/bin/retro-mac-common

show_missing_message() {
  local message="$1"
  local expected_boot=""

  expected_boot="$(retromac_get_boot_override 2>/dev/null || retromac_get_system_disk 2>/dev/null || true)"
  if [[ -z "$expected_boot" ]]; then
    expected_boot="attached Proxmox media or Macintosh HD"
  fi

  cat <<EOF > "${RETRO_MAC_RUNTIME_DIR}/missing-media.txt"
Retro-Mac appliance is up, but the emulator cannot start yet.

$message

Expected ROM path: $RETRO_MAC_ROM_PATH
Expected boot media: $expected_boot

Copy your legally owned ROM and disk image into:
  $RETRO_MAC_ROMS_DIR
  $RETRO_MAC_IMAGES_DIR

Then restart:
  sudo systemctl restart retro-mac-session
EOF
  if [[ "${RETRO_MAC_SESSION_MODE:-}" == "direct-sdl" ]]; then
    clear || true
    cat "${RETRO_MAC_RUNTIME_DIR}/missing-media.txt"
    while sleep 3600; do
      :
    done
  fi
  exec xterm -fa Monospace -fs 12 -hold -e "cat '${RETRO_MAC_RUNTIME_DIR}/missing-media.txt'"
}

retromac_media_exists() {
  local path="${1:-}"
  [[ -f "$path" || -b "$path" ]]
}

append_unique_media_path() {
  local path="${1:-}"
  local target_name="$2"
  local existing=""
  local -n target_ref="$target_name"

  [[ -n "$path" ]] || return 0
  for existing in "${target_ref[@]}"; do
    if [[ "$existing" == "$path" ]]; then
      return 0
    fi
  done

  target_ref+=("$path")
}

append_colon_list_to_media_array() {
  local list="${1:-}"
  local target_name="$2"
  local entry=""
  local entry_real=""
  local exclude_real=""
  local skip_entry=0

  [[ -n "$list" ]] || return 0

  OLDIFS="$IFS"
  IFS=':'
  for entry in $list; do
    [[ -n "$entry" ]] || continue
    entry_real="$(retromac_realpath "$entry" 2>/dev/null || printf '%s' "$entry")"
    skip_entry=0
    for exclude_real in "${@:3}"; do
      if [[ -n "$exclude_real" && "$entry_real" == "$exclude_real" ]]; then
        skip_entry=1
        break
      fi
    done
    if [[ "$skip_entry" -eq 1 ]]; then
      continue
    fi
    append_unique_media_path "$entry" "$target_name"
  done
  IFS="$OLDIFS"
}

handle_emulator_exit() {
  local exit_code="$1"
  local clean_action="${RETRO_MAC_CLEAN_EXIT_ACTION:-poweroff}"
  local failed_action="${RETRO_MAC_FAILED_EXIT_ACTION:-restart-session}"
  local clean_delay="${RETRO_MAC_CLEAN_EXIT_DELAY_SECONDS:-3}"
  local action=""

  if [[ "$exit_code" -eq 0 ]]; then
    action="$clean_action"
  else
    action="$failed_action"
  fi

  case "$action" in
    poweroff)
      if [[ "$exit_code" -eq 0 ]] && [[ "$EUID" -eq 0 ]]; then
        retromac_log "Flushing host writes before power action"
        sync || true
        sleep "$clean_delay"
        retromac_log "Emulator exited cleanly; powering off host VM"
        systemctl --no-block poweroff
      fi
      ;;
    reboot)
      if [[ "$exit_code" -eq 0 ]] && [[ "$EUID" -eq 0 ]]; then
        retromac_log "Flushing host writes before power action"
        sync || true
        sleep "$clean_delay"
        retromac_log "Emulator exited cleanly; rebooting host VM"
        systemctl --no-block reboot
      fi
      ;;
    restart-session|"")
      ;;
    *)
      retromac_log "Unknown exit action '$action'; leaving host state unchanged"
      ;;
  esac

  return "$exit_code"
}

refresh_scanned_media() {
  local configured_cdrom=""
  local boot_override=""
  local boot_real=""
  local extra_real=""
  local installer_real=""
  local library_dir=""
  local system_disk=""
  local system_real=""
  local library_disk=""
  local -a library_disks=()
  local -a library_cdroms=()
  local -a pre_system_disks=()
  local -a post_system_disks=()

  system_disk="$(retromac_get_system_disk 2>/dev/null || true)"
  if [[ -n "$system_disk" ]] && ! retromac_media_exists "$system_disk"; then
    system_disk=""
  fi
  boot_override="$(retromac_get_boot_override 2>/dev/null || true)"
  if [[ -n "$boot_override" ]] && ! retromac_media_exists "$boot_override"; then
    boot_override=""
  fi

  system_real="$(retromac_realpath "$system_disk" 2>/dev/null || true)"
  boot_real="$(retromac_realpath "$boot_override" 2>/dev/null || true)"
  extra_real="$(retromac_realpath "${RETRO_MAC_EXTRA_DISK:-}" 2>/dev/null || true)"
  installer_real="$(retromac_realpath "${RETRO_MAC_INSTALLER_DISK:-}" 2>/dev/null || true)"

  RETRO_MAC_EFFECTIVE_SYSTEM_DISK="$system_disk"
  RETRO_MAC_EFFECTIVE_PRE_SYSTEM_DISKS=""
  RETRO_MAC_EFFECTIVE_POST_SYSTEM_DISKS=""

  if [[ "${RETRO_MAC_AUTOSCAN_MEDIA:-true}" != "true" ]]; then
    if [[ -n "$boot_override" ]]; then
      pre_system_disks+=("$boot_override")
    fi
    if [[ -n "${RETRO_MAC_INSTALLER_DISK:-}" ]] && retromac_media_exists "${RETRO_MAC_INSTALLER_DISK:-}"; then
      post_system_disks+=("${RETRO_MAC_INSTALLER_DISK}")
    fi
    append_colon_list_to_media_array "${RETRO_MAC_ATTACH_DISKS:-}" post_system_disks "$system_real" "$boot_real" "$extra_real" "$installer_real"
    if [[ -n "${RETRO_MAC_EXTRA_DISK:-}" ]] && retromac_media_exists "${RETRO_MAC_EXTRA_DISK:-}"; then
      post_system_disks+=("${RETRO_MAC_EXTRA_DISK}")
    fi
    RETRO_MAC_EFFECTIVE_PRE_SYSTEM_DISKS="$(IFS=:; printf '%s' "${pre_system_disks[*]}")"
    RETRO_MAC_EFFECTIVE_POST_SYSTEM_DISKS="$(IFS=:; printf '%s' "${post_system_disks[*]}")"
    RETRO_MAC_EFFECTIVE_CDROM_IMAGE="${RETRO_MAC_CDROM_IMAGE:-}"
    return 0
  fi

  scan_proxmox_media

  if [[ -f "${RETRO_MAC_RUNTIME_DIR}/scanned-media.env" ]]; then
    # shellcheck disable=SC1090
    source "${RETRO_MAC_RUNTIME_DIR}/scanned-media.env"
  fi

  if [[ -n "${RETRO_MAC_MEDIA_LIBRARY_DIRS:-}" ]]; then
    OLDIFS="$IFS"
    IFS=':'
    for library_dir in $RETRO_MAC_MEDIA_LIBRARY_DIRS; do
      [[ -d "$library_dir" ]] || continue
      collect_media_from_mount "$library_dir" library_disks library_cdroms
    done
    IFS="$OLDIFS"

    if [[ -z "${RETRO_MAC_SCANNED_CDROM_IMAGE:-}" ]] && (( ${#library_cdroms[@]} > 0 )); then
      RETRO_MAC_SCANNED_CDROM_IMAGE="${library_cdroms[0]}"
    fi
  fi

  if [[ -n "$boot_override" ]]; then
    pre_system_disks+=("$boot_override")
    append_colon_list_to_media_array "${RETRO_MAC_SCANNED_PRE_SYSTEM_DISKS:-}" post_system_disks "$system_real" "$boot_real" "$extra_real" "$installer_real"
  else
    append_colon_list_to_media_array "${RETRO_MAC_SCANNED_PRE_SYSTEM_DISKS:-}" pre_system_disks "$system_real" "$extra_real" "$installer_real"
  fi
  append_colon_list_to_media_array "${RETRO_MAC_SCANNED_POST_SYSTEM_DISKS:-}" post_system_disks "$system_real" "$boot_real" "$extra_real" "$installer_real"

  if [[ -n "${RETRO_MAC_INSTALLER_DISK:-}" ]] && retromac_media_exists "${RETRO_MAC_INSTALLER_DISK:-}"; then
    post_system_disks+=("${RETRO_MAC_INSTALLER_DISK}")
  fi
  append_colon_list_to_media_array "${RETRO_MAC_ATTACH_DISKS:-}" post_system_disks "$system_real" "$boot_real" "$extra_real" "$installer_real"
  for library_disk in "${library_disks[@]}"; do
    append_unique_media_path "$library_disk" post_system_disks
  done
  if [[ -n "${RETRO_MAC_EXTRA_DISK:-}" ]] && retromac_media_exists "${RETRO_MAC_EXTRA_DISK:-}"; then
    post_system_disks+=("${RETRO_MAC_EXTRA_DISK}")
  fi

  RETRO_MAC_EFFECTIVE_PRE_SYSTEM_DISKS="$(IFS=:; printf '%s' "${pre_system_disks[*]}")"
  RETRO_MAC_EFFECTIVE_POST_SYSTEM_DISKS="$(IFS=:; printf '%s' "${post_system_disks[*]}")"

  configured_cdrom="${RETRO_MAC_CDROM_IMAGE:-}"
  if [[ -n "$configured_cdrom" ]]; then
    RETRO_MAC_EFFECTIVE_CDROM_IMAGE="$configured_cdrom"
  else
    RETRO_MAC_EFFECTIVE_CDROM_IMAGE="${RETRO_MAC_SCANNED_CDROM_IMAGE:-}"
  fi
}

prime_configured_media() {
  local path=""
  local boot_override=""

  boot_override="$(retromac_get_boot_override 2>/dev/null || true)"
  if [[ -n "$boot_override" ]]; then
    retromac_media_exists "$boot_override" >/dev/null 2>&1 || true
  fi

  if [[ -n "${RETRO_MAC_INSTALLER_DISK:-}" ]]; then
    retromac_media_exists "$RETRO_MAC_INSTALLER_DISK" >/dev/null 2>&1 || true
  fi

  if [[ -n "${RETRO_MAC_CDROM_IMAGE:-}" ]]; then
    retromac_media_exists "$RETRO_MAC_CDROM_IMAGE" >/dev/null 2>&1 || true
  fi

  if [[ -n "${RETRO_MAC_ATTACH_DISKS:-}" ]]; then
    OLDIFS="$IFS"
    IFS=':'
    for path in $RETRO_MAC_ATTACH_DISKS; do
      [[ -n "$path" ]] || continue
      retromac_media_exists "$path" >/dev/null 2>&1 || true
    done
    IFS="$OLDIFS"
  fi

  if [[ -n "${RETRO_MAC_EXTRA_DISK:-}" ]]; then
    retromac_media_exists "$RETRO_MAC_EXTRA_DISK" >/dev/null 2>&1 || true
  fi
}

launch_with_window_management() {
  local window_title="$1"
  shift

  DISPLAY="$RETRO_MAC_DISPLAY" xrandr -s "${RETRO_MAC_RES_WIDTH}x${RETRO_MAC_RES_HEIGHT}" >/dev/null 2>&1 || true

  "$@" &
  local emulator_pid=$!

  if command -v wmctrl >/dev/null 2>&1; then
    for _ in $(seq 1 20); do
      if DISPLAY="$RETRO_MAC_DISPLAY" wmctrl -l | grep -Fq "$window_title"; then
        DISPLAY="$RETRO_MAC_DISPLAY" wmctrl -r "$window_title" -b add,fullscreen,maximized_vert,maximized_horz >/dev/null 2>&1 || true
        DISPLAY="$RETRO_MAC_DISPLAY" wmctrl -r "$window_title" -e 0,0,0,-1,-1 >/dev/null 2>&1 || true
        DISPLAY="$RETRO_MAC_DISPLAY" wmctrl -a "$window_title" >/dev/null 2>&1 || true
        break
      fi
      sleep 1
    done
  fi

  wait "$emulator_pid"
}

write_basilisk_prefs() {
  local screen_mode="win"
  local disk_path=""
  if [[ "$RETRO_MAC_SESSION_MODE" == "direct-sdl" || "${RETRO_MAC_FULLSCREEN:-false}" == "true" ]]; then
    screen_mode="fbdev"
  fi

  cat >"$RETRO_MAC_PREFS_FILE" <<EOF
rom $RETRO_MAC_ROM_PATH
screen ${screen_mode}/${RETRO_MAC_RES_WIDTH}/${RETRO_MAC_RES_HEIGHT}
ramsize $RETRO_MAC_MEMORY_BYTES
frameskip 0
modelid $RETRO_MAC_MODELID
cpu $RETRO_MAC_CPU
fpu $RETRO_MAC_FPU
nogui true
init_grab false
EOF

  if [[ -n "${RETRO_MAC_EFFECTIVE_CDROM_IMAGE:-}" ]]; then
    printf 'cdrom %s\n' "$RETRO_MAC_EFFECTIVE_CDROM_IMAGE" >>"$RETRO_MAC_PREFS_FILE"
  else
    printf 'nocdrom true\n' >>"$RETRO_MAC_PREFS_FILE"
  fi

  if [[ -n "${RETRO_MAC_SHARED_DIR:-}" && -d "${RETRO_MAC_SHARED_DIR:-}" ]]; then
    printf 'extfs %s\n' "$RETRO_MAC_SHARED_DIR" >>"$RETRO_MAC_PREFS_FILE"
  else
    printf 'extfs /__retro_mac_extfs_disabled__\n' >>"$RETRO_MAC_PREFS_FILE"
  fi

  if [[ -n "${RETRO_MAC_EFFECTIVE_PRE_SYSTEM_DISKS:-}" ]]; then
    OLDIFS="$IFS"
    IFS=':'
    for disk_path in $RETRO_MAC_EFFECTIVE_PRE_SYSTEM_DISKS; do
      [[ -n "$disk_path" ]] || continue
      printf 'disk %s\n' "$disk_path" >>"$RETRO_MAC_PREFS_FILE"
    done
    IFS="$OLDIFS"
  fi

  if [[ -n "${RETRO_MAC_EFFECTIVE_SYSTEM_DISK:-}" ]]; then
    printf 'disk %s\n' "$RETRO_MAC_EFFECTIVE_SYSTEM_DISK" >>"$RETRO_MAC_PREFS_FILE"
  fi

  if [[ -n "${RETRO_MAC_EFFECTIVE_POST_SYSTEM_DISKS:-}" ]]; then
    OLDIFS="$IFS"
    IFS=':'
    for disk_path in $RETRO_MAC_EFFECTIVE_POST_SYSTEM_DISKS; do
      [[ -n "$disk_path" ]] || continue
      printf 'disk %s\n' "$disk_path" >>"$RETRO_MAC_PREFS_FILE"
    done
    IFS="$OLDIFS"
  fi

  if [[ "$RETRO_MAC_SESSION_MODE" == "direct-sdl" && -n "${RETRO_MAC_DIRECT_SDL_RENDER_DRIVER:-}" ]]; then
    printf 'sdlrender %s\n' "$RETRO_MAC_DIRECT_SDL_RENDER_DRIVER" >>"$RETRO_MAC_PREFS_FILE"
  fi
}

write_sheepshaver_prefs() {
  local sheepshaver_disk=""

  sheepshaver_disk="$(retromac_get_boot_override 2>/dev/null || retromac_get_system_disk 2>/dev/null || true)"
  cat >"$RETRO_MAC_PREFS_FILE" <<EOF
rom $RETRO_MAC_ROM_PATH
disk $sheepshaver_disk
extfs $RETRO_MAC_SHARED_DIR
screen win/${RETRO_MAC_RES_WIDTH}/${RETRO_MAC_RES_HEIGHT}
windowmodes ${RETRO_MAC_RES_WIDTH}x${RETRO_MAC_RES_HEIGHT}x24
ramsize $RETRO_MAC_MEMORY_BYTES
frameskip 0
gfxaccel false
bootdrive 0
bootdriver 0
ignoresegv true
nocdrom true
nogui true
EOF
}

main() {
  install -d -m 755 "$RETRO_MAC_RUNTIME_DIR" "$RETRO_MAC_HOME"
  export HOME="$RETRO_MAC_HOME"

  if [[ "$RETRO_MAC_SESSION_MODE" != "direct-sdl" ]]; then
    export DISPLAY="$RETRO_MAC_DISPLAY"
  fi

  if [[ ! -x "$RETRO_MAC_EMULATOR_BINARY" ]]; then
    show_missing_message "The emulator binary is missing: $RETRO_MAC_EMULATOR_BINARY"
  fi

  case "$RETRO_MAC_EMULATOR" in
    minivmac)
      if [[ ! -f "$RETRO_MAC_ROM_PATH" || ! -f "$RETRO_MAC_BOOT_IMAGE" ]]; then
        show_missing_message "Mini vMac needs both the Macintosh Plus ROM and a bootable disk image."
      fi
      ln -sfn "$RETRO_MAC_ROM_PATH" "$(dirname "$RETRO_MAC_EMULATOR_BINARY")/vMac.ROM"
      export SDL_AUDIODRIVER=dummy
      exec "$RETRO_MAC_EMULATOR_BINARY" "$RETRO_MAC_BOOT_IMAGE"
      ;;
    basilisk2)
      prime_configured_media
      refresh_scanned_media
      if [[ ! -f "$RETRO_MAC_ROM_PATH" ]]; then
        show_missing_message "Basilisk II needs a 68k ROM."
      fi
      if [[ -z "${RETRO_MAC_EFFECTIVE_PRE_SYSTEM_DISKS:-}" && -z "${RETRO_MAC_EFFECTIVE_SYSTEM_DISK:-}" && -z "${RETRO_MAC_EFFECTIVE_CDROM_IMAGE:-}" ]]; then
        show_missing_message "Basilisk II needs Proxmox-attached boot media or a configured Macintosh HD."
      fi
      write_basilisk_prefs
      if [[ "$RETRO_MAC_EMULATOR_BINARY" == /opt/retro-mac/basilisk2/appdir/* ]]; then
        export APPDIR="/opt/retro-mac/basilisk2/appdir"
        export PATH="${APPDIR}/usr/local/bin:${APPDIR}/usr/bin:${PATH}"
        export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/lib:${APPDIR}/usr/lib/x86_64-linux-gnu:${APPDIR}/usr/lib/i386-linux-gnu:${LD_LIBRARY_PATH:-}"
        export PYTHONPATH="${APPDIR}/usr/share/pyshared:${PYTHONPATH:-}"
        export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-}"
        export PERLLIB="${APPDIR}/usr/share/perl5:${APPDIR}/usr/lib/perl5:${PERLLIB:-}"
        export GSETTINGS_SCHEMA_DIR="${APPDIR}/usr/share/glib-2.0/schemas:${GSETTINGS_SCHEMA_DIR:-}"
        export GTK_DATA_PREFIX="${APPDIR}"
        export GTK_EXE_PREFIX="${APPDIR}"
        export GTK2_RC_FILES="${APPDIR}/usr/share/themes/Clearlooks/gtk-2.0/gtkrc"
        export GDK_PIXBUF_MODULEDIR="${APPDIR}/usr/lib/gdk-pixbuf-2.0/loaders"
        export GDK_PIXBUF_MODULE_FILE="${APPDIR}/usr/lib/gdk-pixbuf-2.0/loaders.cache"
        export GTK_PATH="${APPDIR}/usr/lib/gtk-2.0"
        export GTK_IM_MODULE_FILE="${APPDIR}/usr/lib/gtk-2.0:${GTK_PATH}"
        export GIO_MODULE_DIR="${APPDIR}/usr/lib/gio/modules"
      fi
      if [[ "$RETRO_MAC_SESSION_MODE" == "direct-sdl" ]]; then
        export SDL_VIDEODRIVER="$RETRO_MAC_DIRECT_SDL_VIDEODRIVER"
        export SDL_AUDIODRIVER="$RETRO_MAC_DIRECT_SDL_AUDIODRIVER"
        export SDL_KMSDRM_DEVICE_INDEX="$RETRO_MAC_DIRECT_SDL_DEVICE_INDEX"
        "$RETRO_MAC_EMULATOR_BINARY" --config "$RETRO_MAC_PREFS_FILE"
        handle_emulator_exit "$?"
        exit $?
      else
        export SDL_VIDEODRIVER=x11
        launch_with_window_management "Basilisk II" \
          "$RETRO_MAC_EMULATOR_BINARY" --config "$RETRO_MAC_PREFS_FILE" --display "$RETRO_MAC_DISPLAY" --sdlrender software
        exit $?
      fi
      ;;
    sheepshaver)
      if [[ ! -f "$RETRO_MAC_ROM_PATH" ]] || ! retromac_media_exists "$(retromac_get_boot_override 2>/dev/null || retromac_get_system_disk 2>/dev/null || true)"; then
        show_missing_message "SheepShaver needs a Power Mac ROM and a supported Mac OS disk image."
      fi
      write_sheepshaver_prefs
      export APPDIR="/opt/retro-mac/sheepshaver/appdir"
      export PATH="${APPDIR}/usr/local/bin:${APPDIR}/usr/bin:${PATH}"
      export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/lib:${APPDIR}/usr/lib/x86_64-linux-gnu:${APPDIR}/usr/lib/i386-linux-gnu:${LD_LIBRARY_PATH:-}"
      export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-}"
      exec "$RETRO_MAC_EMULATOR_BINARY" --config "$RETRO_MAC_PREFS_FILE" --display "$RETRO_MAC_DISPLAY" --sdlrender software
      ;;
    *)
      show_missing_message "Unknown emulator profile: $RETRO_MAC_EMULATOR"
      ;;
  esac
}

main "$@"
